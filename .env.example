# Cole aqui os valores do painel do Neon (Connection Details) e do Vercel Blob.
# Renomeie este arquivo para .env.local

# Pooled connection string (hospedado com -pooler). Usada pela aplicação.
DATABASE_URL="postgresql://usuario:senha@ep-xxx-pooler.regiao.aws.neon.tech/store77?sslmode=require"

# Direct connection string (sem -pooler). Usada por migrações do drizzle-kit.
DATABASE_URL_UNPOOLED="postgresql://usuario:senha@ep-xxx.regiao.aws.neon.tech/store77?sslmode=require"

# Gere com: openssl rand -base64 48
AUTH_SECRET="troque-por-uma-string-aleatoria-de-no-minimo-32-caracteres"

# URL pública usada nos links enviados por e-mail (confirmação de cadastro e
# redefinição de senha). Em produção, use o domínio real, sem barra no final.
APP_URL="http://localhost:3000"

# Envio de e-mails transacionais.
# Opção 1 (padrão): SMTP do Gmail usando uma senha de app.
# EMAIL_PASS é a senha de app de 16 caracteres (não é a senha da conta).
EMAIL_PASS=""
# Conta autenticada. Se vazio, usa o endereço de EMAIL_FROM.
EMAIL_USER=""
# Remetente exibido. No Gmail, use a mesma conta autenticada.
EMAIL_FROM="Store77 <sua-conta@gmail.com>"
# SMTP (os padrões já apontam para o Gmail na porta 465).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"

# Opção 2: Resend (https://resend.com), usada como reserva se o SMTP falhar.
# Requer EMAIL_FROM com um domínio verificado no painel do Resend.
RESEND_API_KEY=""

# Somente necessário para upload de fotos em produção (Vercel Blob).
# Em desenvolvimento, sem esta variável, as fotos vão para public/uploads.
BLOB_READ_WRITE_TOKEN=""
