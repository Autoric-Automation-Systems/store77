# Cole aqui os valores do painel do Neon (Connection Details) e do Vercel Blob.
# Renomeie este arquivo para .env.local

# Pooled connection string (hospedado com -pooler). Usada pela aplicação.
DATABASE_URL="postgresql://usuario:senha@ep-xxx-pooler.regiao.aws.neon.tech/store77?sslmode=require"

# Direct connection string (sem -pooler). Usada por migrações do drizzle-kit.
DATABASE_URL_UNPOOLED="postgresql://usuario:senha@ep-xxx.regiao.aws.neon.tech/store77?sslmode=require"

# Gere com: openssl rand -base64 48
AUTH_SECRET="troque-por-uma-string-aleatoria-de-no-minimo-32-caracteres"

# Somente necessário para upload de fotos em produção (Vercel Blob).
# Em desenvolvimento, sem esta variável, as fotos vão para public/uploads.
BLOB_READ_WRITE_TOKEN=""
